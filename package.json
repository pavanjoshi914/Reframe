{
  "name": "reframe",
  "private": true,
  "version": "0.3.0",
  "description": "Reframe \u2014 cross-platform screen recorder + post-recording editor (Linux/Windows/macOS).",
  "author": {
    "name": "Pavan Joshi",
    "email": "pavanj914@gmail.com"
  },
  "license": "MIT",
  "keywords": [
    "screen-recorder",
    "screen-capture",
    "video-editor",
    "webcam",
    "electron",
    "react",
    "typescript",
    "vite",
    "linux",
    "windows",
    "macos",
    "mp4",
    "webm",
    "ffmpeg"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "setup:linux": "node scripts/setup-linux.mjs",
    "postinstall": "node scripts/setup-linux.mjs --check",
    "electron": "node scripts/electron.mjs",
    "start": "npm run build && node scripts/electron.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "package": "npm run build && electron-builder",
    "package:linux": "npm run build && electron-builder --linux",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "fix-webm-duration": "^1.0.6",
    "gifenc": "^1.0.3",
    "lucide-react": "^0.460.0",
    "mediabunny": "^1.45.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.6.0",
    "uiohook-napi": "^1.5.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pavanjoshi914/Reframe.git"
  },
  "build": {
    "appId": "app.reframe.desktop",
    "productName": "Reframe",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "node_modules/ffmpeg-static/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "pavanjoshi914",
        "repo": "Reframe"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "icon": "assets/logo-transparent.png",
      "extraResources": [
        {
          "from": "electron/linux-capture.py",
          "to": "linux-capture.py"
        },
        {
          "from": "electron/cursor-kind.py",
          "to": "cursor-kind.py"
        }
      ]
    },
    "deb": {
      "depends": [
        "libgtk-3-0 | libgtk-3-0t64",
        "libnotify4 | libnotify4t64",
        "libnss3",
        "libxss1",
        "libxtst6",
        "libatspi2.0-0 | libatspi2.0-0t64",
        "libsecret-1-0 | libsecret-1-0t64",
        "libasound2 | libasound2t64",
        "xdg-utils",
        "ffmpeg",
        "gstreamer1.0-pipewire",
        "gstreamer1.0-plugins-base",
        "gstreamer1.0-plugins-good",
        "gstreamer1.0-plugins-ugly",
        "python3-gi",
        "gir1.2-glib-2.0",
        "gir1.2-gstreamer-1.0"
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "assets/logo-transparent.png",
      "extraResources": [
        {
          "from": "electron/cursor-kind.ps1",
          "to": "cursor-kind.ps1"
        }
      ]
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.video",
      "icon": "assets/logo-transparent.png",
      "extraResources": [
        {
          "from": "electron/mac-capture",
          "to": "mac-capture"
        },
        {
          "from": "electron/cursor-kind",
          "to": "cursor-kind"
        }
      ]
    }
  }
}
